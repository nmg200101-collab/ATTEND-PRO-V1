+    private fun confirmPresenceStartupAfterPairing(attempt: Int = 0) {
+        val now = System.currentTimeMillis()
+        val serviceAlive = identity.presenceServiceHeartbeatAt > 0L && now - identity.presenceServiceHeartbeatAt < 12_000L
+        val bleState = identity.lastBleAdvertisingState
+        val lanState = identity.lastLanState
+        if (serviceAlive) {
+            status.text = when {
+                bleState.contains("BLE يعمل") -> "✓ الربط محفوظ وخدمة الاتصال تعمل • Bluetooth يبث فعليًا"
+                lanState.isNotBlank() -> "✓ الربط محفوظ وخدمة الاتصال تعمل • Wi‑Fi/Hotspot نشط"
+                else -> "✓ الربط محفوظ وخدمة الاتصال تعمل • جاري انتظار أول بث/ACK"
+            }
+            return
+        }
+        if (attempt >= 8) {
+            status.text = "الربط محفوظ لكن خدمة الاتصال لم تبدأ. سأعيد تشغيلها الآن؛ افتح حالة الاتصال لمعرفة السبب إذا استمر."
+            startBackgroundPresence()
+            return
+        }
+        Handler(Looper.getMainLooper()).postDelayed({
+            if (!isFinishing) {
+                startBackgroundPresence()
+                confirmPresenceStartupAfterPairing(attempt + 1)
+            }
+        }, 750L)
+    }
