PORT=8080
ATTEND_PRO_DB_FILE=./data/central-data.json
# Separate server administration key. Do NOT use the in-app owner PIN/code here.
ATTEND_PRO_OWNER_API_KEY=replace-with-a-random-secret-at-least-32-chars
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ATTEND_PRO_DATA_KEY=replace-with-base64-32-byte-key

# Maximum offline operating lease after the last successful server validation (1-168 hours).
ATTEND_PRO_OFFLINE_LEASE_HOURS=72
